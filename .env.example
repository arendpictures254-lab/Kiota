# Copy this file to .env and adjust. Never commit .env.

# Database OWNER: used only by migrations and the seed (npm run db:migrate, npm run db:seed).
DATABASE_URL="postgresql://kiota:kiota_dev_password@localhost:5432/kiota"

# The app's own non-owner role. Row-level security always applies to it.
# The seed enables this login in development using the password below.
APP_DATABASE_URL="postgresql://kiota_app:kiota_app_dev_password@localhost:5432/kiota"

# Secret used to hash sign-in codes. Any long random string; different in production.
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"

# SMS driver: "console" prints messages to the server console and .dev/sms-outbox.log.
SMS_DRIVER="console"

# Key that encrypts M-Pesa (Daraja) credentials at rest: 64 hex characters (openssl rand -hex 32).
# Development only: use a different key in production and never commit it.
CREDENTIALS_ENCRYPTION_KEY="df971de4e323c0740729647e79146401fbb1bc01e5a9cd7580fe617b4f93cc6a"

# Public base URL Safaricom calls back (defaults to APP_URL). For Daraja sandbox testing from this
# computer, set it to your Cloudflare quick tunnel URL (see docs/mpesa.md).
# MPESA_CALLBACK_BASE_URL="https://example.trycloudflare.com"
