# Copy this file to .env and adjust. Never commit .env.

# Database OWNER: used only by migrations and the seed (npm run db:migrate, npm run db:seed).
DATABASE_URL="postgresql://kiota:kiota_dev_password@localhost:5432/kiota"

# The app's own non-owner role. Row-level security always applies to it.
# The seed enables this login in development using the password below.
APP_DATABASE_URL="postgresql://kiota_app:kiota_app_dev_password@localhost:5432/kiota"

# Secret used to hash sign-in codes. Any long random string; different in production.
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"

# SMS driver: "console" prints messages to the server console and .dev/sms-outbox.log.
SMS_DRIVER="console"

# Key that encrypts M-Pesa (Daraja) credentials at rest: 64 hex characters (openssl rand -hex 32).
# Development only: use a different key in production and never commit it.
CREDENTIALS_ENCRYPTION_KEY="df971de4e323c0740729647e79146401fbb1bc01e5a9cd7580fe617b4f93cc6a"

# Public base URL Safaricom calls back (defaults to APP_URL). For Daraja sandbox testing from this
# computer, set it to your Cloudflare quick tunnel URL (see docs/mpesa.md).
# MPESA_CALLBACK_BASE_URL="https://example.trycloudflare.com"

# ---- Messaging (docs/messaging.md) -------------------------------------------------------------
# SMS_DRIVER above: "console" for development, "africastalking" for staging and production.
# AT_ENVIRONMENT="sandbox"            # "sandbox" or "live"
# AT_USERNAME="sandbox"               # Africa's Talking app username ("sandbox" in the sandbox)
# AT_API_KEY=""
# Kiota's own sender ID for sign-in codes and platform alerts (paid by Arend Studio).
# SMS_PLATFORM_SENDER_ID="KIOTA"
# Secret in the delivery report URL: https://app.kiota.app/api/hooks/sms/<SMS_CALLBACK_TOKEN>
SMS_CALLBACK_TOKEN="dev-sms-callback-token-change-me"

# WhatsApp: "console" (development default), "cloud" (Meta WhatsApp Cloud API) or "off"
# (production default: everything goes by SMS).
# WHATSAPP_DRIVER="console"
# WHATSAPP_TOKEN=""                   # permanent system-user access token
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_APP_SECRET=""              # checks the signature on Meta's webhooks
# WHATSAPP_VERIFY_TOKEN=""            # any random string, also entered in Meta's webhook settings
# WHATSAPP_API_VERSION="v21.0"

# Arend Studio's OWN Paybill/Till for wallet top-ups (never a school's fee Paybill).
# "simulator" works with `npm run mpesa:simulate -- topup`; "sandbox" or "production" need the keys.
PLATFORM_MPESA_ENVIRONMENT="simulator"
PLATFORM_MPESA_SHORTCODE="600000"
# PLATFORM_MPESA_SHORTCODE_TYPE="paybill"   # or "till"
PLATFORM_MPESA_CALLBACK_TOKEN="dev-platform-topup-token-change-me"
# PLATFORM_MPESA_CONSUMER_KEY=""
# PLATFORM_MPESA_CONSUMER_SECRET=""
# PLATFORM_MPESA_PASSKEY=""

# QUIET_HOURS="21-7"                  # Nairobi hours with no non-critical messages; "off" to disable
# MESSAGE_WORKER="off"                # run the app without the background sender
# Production refuses to start with ALLOW_CONSOLE_SMS=1 or console drivers unless KIOTA_DEMO=1
# marks a demo server whose codes may be printed.
# ALLOW_CONSOLE_SMS="1"
# KIOTA_DEMO="1"
