# Kiota production / staging settings for docker-compose.prod.yml.
# Copy to .env.production on the server (never commit it) and fill in every value.
# Generate passwords and secrets with:  openssl rand -hex 32
# Use letters and digits only in passwords (they go inside database URLs).

# ---- Addresses -------------------------------------------------------------
# The public site and the app. For a staging server use e.g. staging.kiota.app and
# app.staging.kiota.app. DNS for both (and www.<site>) must point at this server first.
SITE_DOMAIN=kiota.app
APP_DOMAIN=app.kiota.app
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=arendpictures254@gmail.com

# ---- Database --------------------------------------------------------------
# Password of the database OWNER (kiota_owner): runs migrations and backups only.
POSTGRES_PASSWORD=change-me-owner-password
# Password of the app role (kiota_app): what the running app connects with.
# Row-level security always applies to this role. Set on every deploy by the migrate service.
APP_DB_PASSWORD=change-me-app-password

# ---- Sign-in ----------------------------------------------------------------
# Secret used to hash one-time sign-in codes and demo-request IP addresses.
# Changing it invalidates codes that are waiting to be used (sessions are not affected).
AUTH_SECRET=change-me-long-random-secret

# ---- SMS ---------------------------------------------------------------------
# "console" prints messages (including sign-in codes) to the app's log instead of sending them.
# It is refused in production unless ALLOW_CONSOLE_SMS=1: use that ONLY on a staging server
# with no real users, until the Africa's Talking driver is added.
SMS_DRIVER=console
ALLOW_CONSOLE_SMS=1

# ---- Backups -----------------------------------------------------------------
# Hour of the nightly backup (Africa/Nairobi time) and how many days to keep.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
