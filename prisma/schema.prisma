// Kiota database schema.
//
// Rules (see CLAUDE.md):
// - Every table holding school data has school_id, and PostgreSQL row-level security
//   (FORCE ROW LEVEL SECURITY) walls each school off. Policies live in the SQL migrations.
// - The app connects as the non-owner role `kiota_app`; migrations run as the owner.
// - Money is integer cents. Payments, receipts, reversals and the audit log are append-only.
// - Table and column names are snake_case.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Platform level (not owned by one school)
// ---------------------------------------------------------------------------

enum SchoolStatus {
  pilot
  active
  suspended
}

/// A school on the platform. Row-level security: visible in its own school context,
/// and its name is listed to its members (school picker) and to Arend admins.
model School {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  /// Short name used as the SMS sender ID (max 11 characters).
  shortName          String       @map("short_name") @db.VarChar(11)
  county             String
  logoUrl            String?      @map("logo_url")
  status             SchoolStatus @default(pilot)
  /// Arend Studio support may see this school's data until this time. Null = off.
  supportAccessUntil DateTime?    @map("support_access_until") @db.Timestamptz(3)
  /// Optional modules switched on for the school: "academics", "boarding", "pocket_money".
  modules            String[]     @default([])
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships      Membership[]
  roles            Role[]
  levels           Level[]
  houses           House[]
  dormitories      Dormitory[]
  academicYears    AcademicYear[]
  importBatches    ImportBatch[]
  voteHeads        VoteHead[]
  wallet           Wallet?
  messageCampaigns MessageCampaign[]
  messages         Message[]
  settings         SchoolSettings?

  @@map("schools")
}

/// One platform-level identity per person, keyed on a verified phone number (E.164).
/// Row-level security: a user sees themselves and members of the current school.
model User {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// E.164, e.g. +254712345678
  phone             String   @unique
  email             String?
  name              String
  /// Arend Studio admin. Platform-level only: grants no access to any school's data.
  isPlatformAdmin   Boolean  @default(false) @map("is_platform_admin")
  /// The language this person chose for Kiota itself (parent portal, sign-in).
  preferredLanguage Language @default(en) @map("preferred_language")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  sessions      Session[]
  guardianLinks GuardianLink[]

  noticeReads    NoticeRead[]
  portalPayments MpesaTransaction[] @relation("PortalPayments")

  @@map("users")
}

/// One-time sign-in codes. Only a hash of the code is stored.
model OtpCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_codes")
}

/// Signed-in sessions. The cookie holds a random token; only its hash is stored.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  /// The school the user chose to open. Null until chosen.
  schoolId   String?   @map("school_id") @db.Uuid
  /// "staff" or "parent", for people who are both. Null until chosen.
  mode       String?
  /// The browser, for "signed in on other devices".
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Permission catalogue (platform-wide). Keys like "staff.manage", "leaveout.approve".
model Permission {
  key               String  @id
  description       String
  /// Only a Director may grant this to a person, one by one. Never part of a custom role.
  directorGrantOnly Boolean @default(false) @map("director_grant_only")

  rolePermissions RolePermission[]
  grants          PermissionGrant[]

  @@map("permissions")
}

// ---------------------------------------------------------------------------
// School owned (school_id + row-level security)
// ---------------------------------------------------------------------------

enum MembershipStatus {
  active
  removed
}

/// Links a user to a school. A user may belong to several schools.
model Membership {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  /// The school's own name for this staff member. Schools never read the platform users.name.
  displayName String           @map("display_name")
  status      MembershipStatus @default(active)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  school          School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles           MembershipRole[]
  grants          PermissionGrant[]
  streams         Stream[]
  staffAttendance StaffAttendance[]

  @@unique([schoolId, userId])
  @@unique([schoolId, id])
  @@map("memberships")
}

/// Roles. Built-in roles have school_id NULL and a fixed key; custom roles belong to one school.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  /// Stable key for built-in roles ("director", "bursar"...). Null for custom roles.
  key         String?  @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school      School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@map("roles")
}

model RolePermission {
  roleId        String  @map("role_id") @db.Uuid
  permissionKey String  @map("permission_key")
  /// Same as the role's school_id (NULL for built-in roles); kept here for row-level security.
  schoolId      String? @map("school_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model MembershipRole {
  schoolId     String   @map("school_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

/// A permission given directly to one person, e.g. "leaveout.approve" granted by the Director.
/// Withdrawing deletes the row; the audit log keeps the history.
model PermissionGrant {
  schoolId      String   @map("school_id") @db.Uuid
  membershipId  String   @map("membership_id") @db.Uuid
  permissionKey String   @map("permission_key")
  grantedById   String   @map("granted_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([membershipId, permissionKey])
  @@map("permission_grants")
}

/// Append-only record of every sensitive action. Never updated or deleted
/// (enforced by grants and a trigger).
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for platform actions (e.g. sign-in).
  schoolId   String?  @map("school_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// School structure (configuration data, per school)
// ---------------------------------------------------------------------------

/// Platform catalogue of Kenyan level defaults (grades, subjects, pathways). Copied into a
/// school's own levels, classes and subjects when the school is created or a level is enabled.
model LevelTemplate {
  key          String   @id
  name         String
  sortOrder    Int      @map("sort_order")
  /// Class names in order, e.g. ["Grade 7", "Grade 8", "Grade 9"].
  grades       String[]
  subjects     String[]
  pathways     String[]
  /// Level that students move into after the last class, e.g. junior to senior. Null = leave school.
  nextLevelKey String?  @map("next_level_key")

  @@map("level_templates")
}

model Level {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  key          String
  name         String
  sortOrder    Int      @map("sort_order")
  enabled      Boolean  @default(false)
  nextLevelKey String?  @map("next_level_key")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes       Class[]
  subjects      Subject[]
  pathways      Pathway[]
  feeStructures FeeStructure[]

  @@unique([schoolId, key])
  @@unique([schoolId, id])
  @@map("levels")
}

/// A grade or form within a level, e.g. "Grade 7" or "Form 3".
model Class {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  levelId   String   @map("level_id") @db.Uuid
  name      String
  /// Order within the level (1, 2, 3...). Promotion moves students to the next one.
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  level    Level     @relation(fields: [schoolId, levelId], references: [schoolId, id], onDelete: Restrict)
  streams  Stream[]
  students Student[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("classes")
}

/// A stream of a class, e.g. "East" in Grade 7 East.
model Stream {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId                 String   @map("school_id") @db.Uuid
  classId                  String   @map("class_id") @db.Uuid
  name                     String
  classTeacherMembershipId String?  @map("class_teacher_membership_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  class        Class                @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  classTeacher Membership?          @relation(fields: [schoolId, classTeacherMembershipId], references: [schoolId, id], onDelete: Restrict)
  students     Student[]
  registers    AttendanceRegister[]

  @@unique([classId, name])
  @@unique([schoolId, id])
  @@map("streams")
}

model House {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  students Student[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("houses")
}

/// Dormitories and their bed capacity. Allocation comes with the boarding module.
model Dormitory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String
  bedCapacity Int      @map("bed_capacity")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, name])
  @@map("dormitories")
}

model AcademicYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  terms  Term[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("academic_years")
}

model Term {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  name           String
  startDate      DateTime  @map("start_date") @db.Date
  halfTermStart  DateTime? @map("half_term_start") @db.Date
  halfTermEnd    DateTime? @map("half_term_end") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  academicYear  AcademicYear   @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)
  feeStructures FeeStructure[]

  @@unique([academicYearId, name])
  @@unique([schoolId, id])
  @@map("terms")
}

/// Senior school pathways, e.g. STEM.
model Pathway {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  levelId   String   @map("level_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  level    Level     @relation(fields: [schoolId, levelId], references: [schoolId, id], onDelete: Restrict)
  students Student[]

  @@unique([levelId, name])
  @@unique([schoolId, id])
  @@map("pathways")
}

/// Subjects / learning areas per level.
model Subject {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  levelId   String   @map("level_id") @db.Uuid
  name      String
  code      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  level    Level            @relation(fields: [schoolId, levelId], references: [schoolId, id], onDelete: Restrict)
  students StudentSubject[]

  @@unique([levelId, name])
  @@unique([schoolId, id])
  @@map("subjects")
}

// ---------------------------------------------------------------------------
// Students and guardians
// ---------------------------------------------------------------------------

enum Gender {
  male
  female
}

enum StudentStatus {
  active
  transferred
  graduated
  suspended
  withdrawn
}

/// Students are archived (status), never deleted: the app role has no DELETE on this table.
model Student {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String        @map("school_id") @db.Uuid
  admissionNumber  String        @map("admission_number")
  /// NEMIS Unique Personal Identifier.
  upi              String?
  firstName        String        @map("first_name")
  middleName       String?       @map("middle_name")
  lastName         String        @map("last_name")
  gender           Gender
  dateOfBirth      DateTime      @map("date_of_birth") @db.Date
  /// The cropped portrait (ID cards, passes, the gate). The upload as it was: photoOriginalKey.
  photoKey         String?       @map("photo_key")
  photoOriginalKey String?       @map("photo_original_key")
  classId          String        @map("class_id") @db.Uuid
  streamId         String?       @map("stream_id") @db.Uuid
  boarder          Boolean       @default(false)
  houseId          String?       @map("house_id") @db.Uuid
  pathwayId        String?       @map("pathway_id") @db.Uuid
  specialNeeds     String?       @map("special_needs")
  status           StudentStatus @default(active)
  statusDate       DateTime      @default(now()) @map("status_date") @db.Date
  statusReason     String?       @map("status_reason")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  class           Class                 @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  stream          Stream?               @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: Restrict)
  house           House?                @relation(fields: [schoolId, houseId], references: [schoolId, id], onDelete: Restrict)
  pathway         Pathway?              @relation(fields: [schoolId, pathwayId], references: [schoolId, id], onDelete: Restrict)
  medical         StudentMedical?
  statusChanges   StudentStatusChange[]
  attendanceMarks AttendanceMark[]
  absenceAlerts   AbsenceAlert[]
  cards           StudentCard[]
  uniformIssues   UniformIssue[]
  guardians       GuardianLink[]
  subjects        StudentSubject[]
  documents       StudentDocument[]
  openingBalance  OpeningBalance?

  leaveouts Leaveout[]

  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, id])
  @@index([schoolId, classId, streamId])
  @@map("students")
}

/// Medical notes and allergies. Row-level security: only with "students.medical.view".
model StudentMedical {
  studentId    String   @id @map("student_id") @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  medicalNotes String?  @map("medical_notes")
  allergies    String?
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, studentId])
  @@map("student_medical")
}

/// Append-only history of status changes.
model StudentStatusChange {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String         @map("school_id") @db.Uuid
  studentId  String         @map("student_id") @db.Uuid
  fromStatus StudentStatus? @map("from_status")
  toStatus   StudentStatus  @map("to_status")
  date       DateTime       @db.Date
  reason     String?
  changedBy  String         @map("changed_by") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@map("student_status_changes")
}

/// Senior school: the subjects a student takes.
model StudentSubject {
  schoolId  String @map("school_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  subject Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Restrict)

  @@id([studentId, subjectId])
  @@map("student_subjects")
}

model StudentDocument {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  kind         String
  fileKey      String   @map("file_key")
  fileName     String   @map("file_name")
  contentType  String   @map("content_type")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@map("student_documents")
}

enum GuardianRelationship {
  mother
  father
  guardian
  sponsor
  other
}

enum Language {
  en
  sw
}

/// Links a platform-level user (the parent) to one student at one school. The only way a parent
/// reaches school data. `name` is the school's own name for the guardian, so a school never sees
/// what another school typed.
model GuardianLink {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String               @map("school_id") @db.Uuid
  studentId           String               @map("student_id") @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  name                String
  relationship        GuardianRelationship
  language            Language             @default(en)
  receivesFees        Boolean              @default(true) @map("receives_fees")
  receivesAcademics   Boolean              @default(true) @map("receives_academics")
  receivesBoarding    Boolean              @default(true) @map("receives_boarding")
  authorisedToCollect Boolean              @default(false) @map("authorised_to_collect")
  /// The school says this phone number uses WhatsApp (messages may go there, SMS as fallback).
  whatsapp            Boolean              @default(false)
  /// When the parent first signed in to the portal while linked here (the school follows up).
  portalFirstSeenAt   DateTime?            @map("portal_first_seen_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  student      Student                 @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  confirmation ParentLinkConfirmation?

  @@unique([studentId, userId])
  @@index([userId])
  @@map("guardian_links")
}

/// Platform level, never visible to schools: a link the parent must confirm by SMS code because
/// they already have confirmed links at another school. No row = confirmed.
model ParentLinkConfirmation {
  guardianLinkId String    @id @map("guardian_link_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  status         String    @default("pending")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  declinedAt     DateTime? @map("declined_at") @db.Timestamptz(3)

  link GuardianLink @relation(fields: [guardianLinkId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("parent_link_confirmations")
}

/// Opening fee balances from the import, staged for the fees module. Not a money record yet:
/// the fees module posts each one as the student's first ledger entry and sets posted = true.
model OpeningBalance {
  studentId   String   @id @map("student_id") @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  /// Integer cents. Positive = the student owes; negative = credit.
  amountCents Int      @map("amount_cents")
  posted      Boolean  @default(false)
  source      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, studentId])
  @@map("opening_balances")
}

/// An uploaded import file between preview and confirm. Holds the parsed rows, not student data.
model ImportBatch {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  fileName    String    @map("file_name")
  fileHash    String    @map("file_hash")
  payload     Json
  status      String    @default("previewed")
  summary     Json?
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  importedAt  DateTime? @map("imported_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("import_batches")
}

// ---------------------------------------------------------------------------
// Public website (platform level, no school data)
// ---------------------------------------------------------------------------

enum DemoRequestStatus {
  new
  contacted
  demo_booked
  won
  lost
}

/// "Book a demo" requests from kiota.app. Written through app_submit_demo_request();
/// readable only by Arend admins. Never holds student or child details.
model DemoRequest {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolName   String            @map("school_name")
  county       String
  contactName  String            @map("contact_name")
  contactRole  String            @map("contact_role")
  phone        String
  email        String?
  studentCount Int               @map("student_count")
  schoolType   String            @map("school_type")
  message      String?
  status       DemoRequestStatus @default(new)
  /// SHA-256 of the sender's IP address, for rate limiting only.
  ipHash       String            @map("ip_hash")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ipHash, createdAt])
  @@map("demo_requests")
}

// ---------------------------------------------------------------------------
// Fees and finance (all school-owned; money in integer cents)
// ---------------------------------------------------------------------------

/// A vote head: what money is for (tuition, boarding...). Payments are allocated to vote heads
/// in priority order (1 = paid first).
model VoteHead {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  priority  Int
  /// The vote head opening balances (arrears) are posted to. Usually paid first.
  isArrears Boolean  @default(false) @map("is_arrears")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  feeItems      FeeItem[]
  discountRules DiscountRule[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("vote_heads")
}

/// A fee item (e.g. "Tuition fee") belongs to one vote head.
model FeeItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  voteHeadId String   @map("vote_head_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voteHead          VoteHead           @relation(fields: [schoolId, voteHeadId], references: [schoolId, id], onDelete: Restrict)
  feeStructureLines FeeStructureLine[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("fee_items")
}

enum FeeAppliesTo {
  boarder
  day
}

/// What a student of one level pays in one term, as a boarder or a day scholar.
model FeeStructure {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  termId    String       @map("term_id") @db.Uuid
  levelId   String       @map("level_id") @db.Uuid
  appliesTo FeeAppliesTo @map("applies_to")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  term         Term               @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Restrict)
  level        Level              @relation(fields: [schoolId, levelId], references: [schoolId, id], onDelete: Restrict)
  lines        FeeStructureLine[]
  installments FeeInstallment[]

  @@unique([termId, levelId, appliesTo])
  @@unique([schoolId, id])
  @@map("fee_structures")
}

model FeeStructureLine {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String @map("school_id") @db.Uuid
  feeStructureId String @map("fee_structure_id") @db.Uuid
  feeItemId      String @map("fee_item_id") @db.Uuid
  amountCents    Int    @map("amount_cents")

  structure FeeStructure @relation(fields: [schoolId, feeStructureId], references: [schoolId, id], onDelete: Cascade)
  feeItem   FeeItem      @relation(fields: [schoolId, feeItemId], references: [schoolId, id], onDelete: Restrict)

  @@unique([feeStructureId, feeItemId])
  @@map("fee_structure_lines")
}

/// Instalment plan of a fee structure: share of the term's fees due by each date.
model FeeInstallment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  feeStructureId String   @map("fee_structure_id") @db.Uuid
  dueDate        DateTime @map("due_date") @db.Date
  /// Share of the invoice due by this date, in basis points (5000 = 50%).
  percentBp      Int      @map("percent_bp")

  structure FeeStructure @relation(fields: [schoolId, feeStructureId], references: [schoolId, id], onDelete: Cascade)

  @@map("fee_installments")
}

/// Rule-based discounts. Today: sibling discounts (the Nth child of a family and later).
model DiscountRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  name            String
  /// Applies to the Nth child of a family and every child after (2 = second child onwards).
  siblingPosition Int      @map("sibling_position")
  percentBp       Int      @map("percent_bp")
  voteHeadId      String   @map("vote_head_id") @db.Uuid
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voteHead VoteHead @relation(fields: [schoolId, voteHeadId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, name])
  @@map("discount_rules")
}

/// A bursary or scholarship for one student. Applied when term invoices are generated.
model Bursary {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  /// Null = every term.
  termId      String?  @map("term_id") @db.Uuid
  kind        String
  sponsorName String   @map("sponsor_name")
  /// "full", "percent" or "amount".
  coverage    String
  percentBp   Int?     @map("percent_bp")
  amountCents Int?     @map("amount_cents")
  /// Null = spread over all vote heads of the invoice.
  voteHeadId  String?  @map("vote_head_id") @db.Uuid
  active      Boolean  @default(true)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("bursaries")
}

/// A term invoice. Append-only.
model Invoice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  termId         String   @map("term_id") @db.Uuid
  feeStructureId String   @map("fee_structure_id") @db.Uuid
  totalCents     Int      @map("total_cents")
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([studentId, termId])
  @@map("invoices")
}

enum LedgerEntryType {
  invoice
  charge
  payment
  discount
  bursary
  opening_balance
  reversal
  credit_applied
}

/// The student ledger. Append-only. Positive = the student owes more; negative = paid or credited.
/// The balance is always SUM(amount_cents), never a stored number.
model LedgerEntry {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String          @map("school_id") @db.Uuid
  studentId       String          @map("student_id") @db.Uuid
  type            LedgerEntryType
  amountCents     Int             @map("amount_cents")
  termId          String?         @map("term_id") @db.Uuid
  description     String
  invoiceId       String?         @map("invoice_id") @db.Uuid
  paymentId       String?         @map("payment_id") @db.Uuid
  reversesEntryId String?         @map("reverses_entry_id") @db.Uuid
  createdById     String          @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  lines LedgerLine[]

  @@unique([schoolId, id])
  @@index([studentId, createdAt])
  @@index([schoolId, type, createdAt])
  @@map("ledger_entries")
}

/// How a ledger entry splits over vote heads. vote_head_id NULL = unallocated credit.
model LedgerLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String  @map("school_id") @db.Uuid
  entryId     String  @map("entry_id") @db.Uuid
  studentId   String  @map("student_id") @db.Uuid
  voteHeadId  String? @map("vote_head_id") @db.Uuid
  amountCents Int     @map("amount_cents")

  entry LedgerEntry @relation(fields: [schoolId, entryId], references: [schoolId, id], onDelete: Restrict)

  @@index([studentId, voteHeadId])
  @@map("ledger_lines")
}

enum PaymentMethod {
  mpesa
  cash
  bank
  cheque
}

/// A payment. Append-only: corrected only by a reversal.
model Payment {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String        @map("school_id") @db.Uuid
  studentId          String        @map("student_id") @db.Uuid
  method             PaymentMethod
  amountCents        Int           @map("amount_cents")
  /// M-Pesa transaction ID, bank slip or cheque number. Unique per school and method.
  reference          String?
  payerName          String?       @map("payer_name")
  payerPhone         String?       @map("payer_phone")
  paidAt             DateTime      @map("paid_at") @db.Timestamptz(3)
  receivedById       String        @map("received_by_id") @db.Uuid
  mpesaTransactionId String?       @unique @map("mpesa_transaction_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  receipt  Receipt?
  reversal Reversal?

  @@unique([schoolId, method, reference])
  @@unique([schoolId, id])
  @@index([schoolId, paidAt])
  @@map("payments")
}

/// One receipt per payment, numbered without gaps per school. Append-only.
model Receipt {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  paymentId         String   @unique @map("payment_id") @db.Uuid
  number            Int
  /// Balance right after this payment (snapshot printed on the receipt).
  balanceAfterCents Int      @map("balance_after_cents")
  /// Unguessable token for the share link /r/<token>.
  shareToken        String   @unique @map("share_token")
  issuedById        String   @map("issued_by_id") @db.Uuid
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [schoolId, paymentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, number])
  @@unique([schoolId, paymentId])
  @@map("receipts")
}

/// Per-school receipt counter. Incremented inside the payment's transaction: numbers are
/// sequential and gap-free (a rolled-back payment gives its number back).
model ReceiptCounter {
  schoolId   String @id @map("school_id") @db.Uuid
  lastNumber Int    @map("last_number")

  @@map("receipt_counters")
}

/// A reversal of one payment. Append-only.
model Reversal {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  paymentId     String   @unique @map("payment_id") @db.Uuid
  reason        String
  ledgerEntryId String   @map("ledger_entry_id") @db.Uuid
  reversedById  String   @map("reversed_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [schoolId, paymentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, paymentId])
  @@map("reversals")
}

/// A parent's promise to pay an amount by a date. Kept or broken is computed from payments.
model Pledge {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  amountCents Int       @map("amount_cents")
  dueDate     DateTime  @map("due_date") @db.Date
  madeBy      String    @map("made_by")
  note        String?
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("pledges")
}

/// In-app notifications for one staff member (e.g. the Director, when a receipt is reversed).
model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  title        String
  body         String
  link         String?
  readAt       DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([membershipId, readAt])
  @@map("notifications")
}

/// M-Pesa (Daraja) settings of one school. Secrets are encrypted at rest (AES-256-GCM).
model MpesaSettings {
  schoolId              String   @id @map("school_id") @db.Uuid
  shortcode             String
  /// "paybill" or "till".
  shortcodeType         String   @map("shortcode_type")
  /// "simulator", "sandbox" or "production".
  environment           String
  consumerKeyEnc        String?  @map("consumer_key_enc")
  consumerSecretEnc     String?  @map("consumer_secret_enc")
  passkeyEnc            String?  @map("passkey_enc")
  initiatorName         String?  @map("initiator_name")
  securityCredentialEnc String?  @map("security_credential_enc")
  /// Secret in the callback URLs. Encrypted (to show the URLs) and hashed (to look up the school).
  callbackTokenEnc      String   @map("callback_token_enc")
  callbackTokenHash     String   @unique @map("callback_token_hash")
  updatedById           String   @map("updated_by_id") @db.Uuid
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("mpesa_settings")
}

/// Every M-Pesa transaction Kiota hears about (C2B confirmations and STK pushes). Not a money
/// record: a payment is created only after Daraja confirms the transaction.
model MpesaTransaction {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String    @map("school_id") @db.Uuid
  /// "c2b" or "stk".
  kind              String
  /// M-Pesa transaction ID (receipt number), e.g. SL41H2K3XY.
  transId           String?   @map("trans_id")
  checkoutRequestId String?   @unique @map("checkout_request_id")
  amountCents       Int?      @map("amount_cents")
  msisdn            String?
  billRef           String?   @map("bill_ref")
  payerName         String?   @map("payer_name")
  transTime         DateTime? @map("trans_time") @db.Timestamptz(3)
  studentId         String?   @map("student_id") @db.Uuid
  requestedById     String?   @map("requested_by_id") @db.Uuid
  /// A parent who started this prompt from the parent portal (they may see its outcome).
  portalUserId      String?   @map("portal_user_id") @db.Uuid
  /// stk_requested, pending_verification, posted, suspense, assigned, rejected, failed
  status            String
  statusDetail      String?   @map("status_detail")
  paymentId         String?   @map("payment_id") @db.Uuid
  raw               Json
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  portalUser        User?     @relation("PortalPayments", fields: [portalUserId], references: [id], onDelete: SetNull)

  @@unique([schoolId, transId])
  @@index([schoolId, status])
  @@map("mpesa_transactions")
}

// ---------------------------------------------------------------------------
// Messaging: SMS and WhatsApp from a prepaid wallet per school
// ---------------------------------------------------------------------------

enum MessageChannel {
  sms
  whatsapp
}

enum MessageStatus {
  queued
  sending
  sent
  delivered
  failed
}

/// One prepaid messaging wallet per school. Prices, overdraft and the sender ID are set by
/// Arend Studio only (app_admin_set_wallet); the school sets its low-balance alert threshold.
/// The balance is never stored: it is always SUM(wallet_entries.amount_cents).
model Wallet {
  schoolId                 String    @id @map("school_id") @db.Uuid
  /// Price per SMS unit (one 160-character GSM-7 part), integer cents.
  smsUnitPriceCents        Int       @default(100) @map("sms_unit_price_cents")
  /// Price per WhatsApp template message, integer cents.
  whatsappPriceCents       Int       @default(150) @map("whatsapp_price_cents")
  /// How far below zero critical messages (leave-out alerts, emergencies) may take the wallet.
  overdraftLimitCents      Int       @default(20000) @map("overdraft_limit_cents")
  lowBalanceThresholdCents Int       @default(50000) @map("low_balance_threshold_cents")
  /// When the Director and Bursar were last told the balance is low. Cleared by a top-up.
  lowBalanceAlertedAt      DateTime? @map("low_balance_alerted_at") @db.Timestamptz(3)
  /// The school's own SMS sender ID (max 11 characters), once the networks approve it.
  senderId                 String?   @map("sender_id") @db.VarChar(11)
  senderIdApproved         Boolean   @default(false) @map("sender_id_approved")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  entries WalletEntry[]
  topups  WalletTopup[]

  @@map("wallets")
}

enum WalletEntryType {
  /// M-Pesa top-up confirmed by Safaricom.
  topup
  /// Bank transfer recorded by an Arend admin.
  manual_topup
  /// Free credit from Arend Studio.
  starter_credit
  /// Cost of a message, taken when it is queued.
  reserve
  /// A failed message gives its cost back.
  refund
  /// The provider counted a different number of units than estimated.
  adjustment
}

/// The wallet ledger. Append-only (grants and a trigger). Positive = credit, negative = spent.
model WalletEntry {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String          @map("school_id") @db.Uuid
  type        WalletEntryType
  amountCents Int             @map("amount_cents")
  description String
  messageId   String?         @map("message_id") @db.Uuid
  /// One credit per top-up, ever (duplicate callbacks cannot credit twice).
  topupId     String?         @unique @map("topup_id") @db.Uuid
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet      Wallet          @relation(fields: [schoolId], references: [schoolId], onDelete: Restrict)

  /// One reserve, one refund and one adjustment per message at most.
  @@unique([messageId, type])
  @@index([schoolId, createdAt])
  @@map("wallet_entries")
}

/// A request to add money to a wallet: M-Pesa STK Push to Arend Studio's own Paybill, a manual
/// bank top-up or starter credit. Not a money record: the credit is the wallet entry.
model WalletTopup {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String    @map("school_id") @db.Uuid
  /// "mpesa", "manual" or "starter".
  method            String
  amountCents       Int       @map("amount_cents")
  /// stk_requested, pending_verification, verification_failed, posting, completed, failed
  status            String
  statusDetail      String?   @map("status_detail")
  phone             String?
  checkoutRequestId String?   @unique @map("checkout_request_id")
  /// M-Pesa receipt number.
  transId           String?   @unique @map("trans_id")
  reference         String?
  note              String?
  requestedById     String?   @map("requested_by_id") @db.Uuid
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  wallet            Wallet    @relation(fields: [schoolId], references: [schoolId], onDelete: Restrict)

  @@index([schoolId, createdAt])
  @@map("wallet_topups")
}

/// Platform registry of message templates (configuration, not code): one row per template and
/// language. WhatsApp templates must be approved by Meta before they are used.
model MessageTemplate {
  key            String
  language       Language
  description    String
  /// fees, academics, boarding or general: which guardian setting applies.
  category       String
  /// Critical messages go out during quiet hours and, within the overdraft, from an empty wallet.
  critical       Boolean  @default(false)
  /// SMS text with {placeholders}; [[ ... ]] is left out when a placeholder inside is empty.
  smsBody        String   @map("sms_body")
  whatsappName   String?  @map("whatsapp_name")
  /// The approved WhatsApp text, for display ({{1}}, {{2}}...).
  whatsappBody   String?  @map("whatsapp_body")
  /// Placeholder names that fill {{1}}, {{2}}... in order.
  whatsappParams String[] @map("whatsapp_params")
  /// "document" when the template carries a PDF (receipts).
  whatsappHeader String?  @map("whatsapp_header")
  /// not_submitted, pending, approved, rejected
  whatsappStatus String   @default("not_submitted") @map("whatsapp_status")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([key, language])
  @@map("message_templates")
}

/// A bulk send: a notice or a batch of fee reminders.
model MessageCampaign {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String         @map("school_id") @db.Uuid
  /// "notice" or "fee_reminder".
  kind        String
  title       String
  body        String?
  bodySw      String?        @map("body_sw")
  audience    Json
  channel     MessageChannel
  category    String
  critical    Boolean        @default(false)
  recipients  Int
  units       Int
  costCents   Int            @map("cost_cents")
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  reads       NoticeRead[]

  @@index([schoolId, createdAt])
  @@map("message_campaigns")
}

/// One message to one phone. The messages table is also the sending queue (status queued,
/// next_attempt_at). Row-level security: the Director (messages.view_all) sees all; others see
/// messages about students they can see (a class teacher: their streams).
model Message {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String         @map("school_id") @db.Uuid
  campaignId        String?        @map("campaign_id") @db.Uuid
  studentId         String?        @map("student_id") @db.Uuid
  guardianLinkId    String?        @map("guardian_link_id") @db.Uuid
  toPhone           String         @map("to_phone")
  channel           MessageChannel
  language          Language
  templateKey       String         @map("template_key")
  category          String
  critical          Boolean        @default(false)
  /// The text sent (SMS) or shown (WhatsApp).
  body              String
  /// Placeholder values, kept so a failed WhatsApp message can be re-sent as SMS.
  params            Json?
  mediaUrl          String?        @map("media_url")
  units             Int
  /// Reserved cost (the wallet entries are the money record).
  costCents         Int            @map("cost_cents")
  status            MessageStatus  @default(queued)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt          DateTime?      @map("locked_at") @db.Timestamptz(3)
  provider          String?
  providerMessageId String?        @map("provider_message_id")
  error             String?
  /// A WhatsApp message that is re-sent as SMS if it cannot be delivered.
  fallbackToSms     Boolean        @default(false) @map("fallback_to_sms")
  /// The WhatsApp message this SMS replaces.
  fallbackOfId      String?        @map("fallback_of_id") @db.Uuid
  createdById       String?        @map("created_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz(3)
  failedAt          DateTime?      @map("failed_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  school            School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([provider, providerMessageId])
  @@index([schoolId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([studentId])
  @@index([guardianLinkId])
  @@index([campaignId])
  @@map("messages")
}

/// Who read which notice in the parent portal (the school sees read counts per notice).
model NoticeRead {
  schoolId   String          @map("school_id") @db.Uuid
  campaignId String          @map("campaign_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  readAt     DateTime        @default(now()) @map("read_at") @db.Timestamptz(3)
  campaign   MessageCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([schoolId, campaignId])
  @@map("notice_reads")
}

/// A leave-out (exeat): the request, its approval, the gate pass, and the exit and return.
/// The student's name, class, admission number and photo are copied in when it is requested,
/// so the gate guard can check the pass without access to student records.
model Leaveout {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String    @map("school_id") @db.Uuid
  studentId             String    @map("student_id") @db.Uuid
  reasonId              String?   @map("reason_id") @db.Uuid
  /// The reason as chosen (the school's list) and any details.
  reason                String
  details               String?
  leaveAt               DateTime  @map("leave_at") @db.Timestamptz(3)
  returnAt              DateTime  @map("return_at") @db.Timestamptz(3)
  /// "guardian" (marked authorised to collect) or "other" (a person the parent approves).
  collectorKind         String    @map("collector_kind")
  collectorLinkId       String?   @map("collector_link_id") @db.Uuid
  collectorName         String    @map("collector_name")
  collectorPhone        String    @map("collector_phone")
  collectorRelationship String    @map("collector_relationship")
  /// 4 digits the parent replies with ("YES 1234") to approve another collector.
  collectorConfirmCode  String?   @map("collector_confirm_code")
  /// SHA-256 of the token in the parent's "Tap to approve" link (kiota.app/a/<token>).
  collectorLinkHash     String?   @unique @map("collector_link_hash")
  collectorApprovedAt   DateTime? @map("collector_approved_at") @db.Timestamptz(3)
  collectorApprovedById String?   @map("collector_approved_by_id") @db.Uuid
  /// awaiting_parent, pending, approved, declined, cancelled, out, returned
  status                String
  /// "staff", "parent" or "bulk" (half term).
  requestedVia          String    @map("requested_via")
  requestedById         String    @map("requested_by_id") @db.Uuid
  decidedById           String?   @map("decided_by_id") @db.Uuid
  decidedAt             DateTime? @map("decided_at") @db.Timestamptz(3)
  declineReason         String?   @map("decline_reason")
  cancelledById         String?   @map("cancelled_by_id") @db.Uuid
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason          String?   @map("cancel_reason")
  /// Signed gate pass token (KP1....): carries no student details.
  passToken             String?   @unique @map("pass_token")
  /// SHA-256 of "<leaveout id>:<pickup code>" (the gate checks the code offline).
  pickupCodeHash        String?   @map("pickup_code_hash")
  studentName           String    @map("student_name")
  admissionNumber       String    @map("admission_number")
  classLabel            String    @map("class_label")
  photoKey              String?   @map("photo_key")
  exitedAt              DateTime? @map("exited_at") @db.Timestamptz(3)
  exitById              String?   @map("exit_by_id") @db.Uuid
  returnedAt            DateTime? @map("returned_at") @db.Timestamptz(3)
  returnById            String?   @map("return_by_id") @db.Uuid
  overdueAlertedAt      DateTime? @map("overdue_alerted_at") @db.Timestamptz(3)
  batchId               String?   @map("batch_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  events  LeaveoutEvent[]
  student Student         @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, status])
  @@index([schoolId, studentId])
  @@index([schoolId, leaveAt])
  @@map("leaveouts")
}

/// Exits and returns recorded at the gate (append-only), including ones made offline and synced
/// later. A conflict (e.g. the pass was cancelled while the device was offline) is flagged.
model LeaveoutEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  leaveoutId    String   @map("leaveout_id") @db.Uuid
  /// "exit" or "return"
  kind          String
  /// When it happened at the gate (the device's clock).
  at            DateTime @db.Timestamptz(3)
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  byId          String   @map("by_id") @db.Uuid
  /// The gate device's own id for the event, so a repeated sync records it once.
  deviceEventId String   @map("device_event_id")
  offline       Boolean  @default(false)
  conflict      String?

  leaveout Leaveout @relation(fields: [leaveoutId], references: [id], onDelete: Restrict)

  @@unique([schoolId, deviceEventId])
  @@index([schoolId, leaveoutId])
  @@map("leaveout_events")
}

/// The reasons a school offers for a leave-out (configuration, copied from defaults per school).
model LeaveoutReason {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  name     String
  position Int
  active   Boolean @default(true)

  @@unique([schoolId, name])
  @@map("leaveout_reasons")
}

/// Half-term passes generated in one go (a class, a level or all boarders).
model LeaveoutBatch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  title       String
  audience    Json
  created     Int
  skipped     Int
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([schoolId, createdAt])
  @@map("leaveout_batches")
}

/// Each school's gate pass signing key (Ed25519). Gate devices get only the public key, so they
/// can check a pass offline but never make one. The private key is encrypted at rest.
model LeaveoutPassKey {
  schoolId      String   @id @map("school_id") @db.Uuid
  publicKey     String   @map("public_key")
  privateKeyEnc String   @map("private_key_enc")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("leaveout_pass_keys")
}

// ---------------------------------------------------------------------------
// School settings, attendance, student ID cards
// ---------------------------------------------------------------------------

/// One row per school (created with the school): settings that are not their own table.
model SchoolSettings {
  schoolId                 String   @id @map("school_id") @db.Uuid
  /// How early before the leave time the gate lets a child out.
  leaveoutEarlyExitMinutes Int      @default(60) @map("leaveout_early_exit_minutes")
  /// SMS a day scholar's parents when they are marked absent.
  absenceSmsDayScholars    Boolean  @default(true) @map("absence_sms_day_scholars")
  /// Minutes after the register before that SMS goes (a quick correction cancels it).
  absenceSmsDelayMinutes   Int      @default(30) @map("absence_sms_delay_minutes")
  /// Also SMS a boarder's parents straight away (normally only when the boarding staff mark
  /// the child "not found").
  absenceSmsBoarders       Boolean  @default(false) @map("absence_sms_boarders")
  /// The school week: days registers are expected (0 = Sunday ... 6 = Saturday).
  schoolDays               Int[]    @default([1, 2, 3, 4, 5]) @map("school_days")
  /// Levels that also have Saturday classes (e.g. senior school only), when Saturday is not a
  /// school day for everyone.
  saturdayLevelIds         String[] @default([]) @map("saturday_level_ids") @db.Uuid
  /// Stores: flag a meal issue that differs from the ration scale by more than this percentage.
  mealVariancePercent      Int      @default(10) @map("meal_variance_percent")
  /// Stores: the vote head uniform issues are charged to (the "Uniform" vote head if not set).
  uniformVoteHeadId        String?  @map("uniform_vote_head_id") @db.Uuid
  /// The back of the student ID card: the school's phone, email and address.
  cardPhone                String?  @map("card_phone")
  cardEmail                String?  @map("card_email")
  cardAddress              String?  @map("card_address")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("school_settings")
}

/// The registers a school takes each day (e.g. Morning, Afternoon), with a cut-off time.
/// Times are minutes after midnight, Nairobi time.
model AttendanceSession {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String  @map("school_id") @db.Uuid
  name         String
  opensMinute  Int     @map("opens_minute")
  cutoffMinute Int     @map("cutoff_minute")
  position     Int
  active       Boolean @default(true)

  registers AttendanceRegister[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("attendance_sessions")
}

/// One register per stream, session and day. Submitted once; corrected the same day by the
/// teacher, later only with attendance.manage (every change is in the audit log).
model AttendanceRegister {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  streamId      String    @map("stream_id") @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  date          DateTime  @db.Date
  submittedAt   DateTime  @map("submitted_at") @db.Timestamptz(3)
  submittedById String    @map("submitted_by_id") @db.Uuid
  correctedAt   DateTime? @map("corrected_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  stream  Stream            @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: Restrict)
  session AttendanceSession @relation(fields: [schoolId, sessionId], references: [schoolId, id], onDelete: Restrict)
  marks   AttendanceMark[]

  @@unique([schoolId, streamId, sessionId, date])
  @@unique([schoolId, id])
  @@index([schoolId, date])
  @@map("attendance_registers")
}

/// One student on one register: present, absent, late or on_leave (an approved leave-out).
model AttendanceMark {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  registerId String   @map("register_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  date       DateTime @db.Date
  status     String
  leaveoutId String?  @map("leaveout_id") @db.Uuid
  markedById String   @map("marked_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  register AttendanceRegister @relation(fields: [schoolId, registerId], references: [schoolId, id], onDelete: Restrict)
  student  Student            @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([registerId, studentId])
  @@unique([schoolId, id])
  @@index([schoolId, studentId, date])
  @@index([schoolId, date])
  @@map("attendance_marks")
}

/// What happens after a student is marked absent:
///  - parent_sms: an SMS to the parents when due_at comes, unless the mark was corrected first;
///  - boarder: the boarding staff look for the child (found, or not found: parents are told).
model AbsenceAlert {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  markId       String    @map("mark_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  date         DateTime  @db.Date
  /// "parent_sms" or "boarder"
  kind         String
  /// parent_sms: waiting, sent, cancelled. boarder: waiting, found, not_found, cancelled.
  status       String
  dueAt        DateTime? @map("due_at") @db.Timestamptz(3)
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([schoolId, markId])
  @@map("absence_alerts")
}

/// A staff member's day: "I'm in" and "I'm leaving" on their phone, or marked by the Principal.
/// No location is recorded.
model StaffAttendance {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  date         DateTime  @db.Date
  /// present, absent or leave
  status       String
  inAt         DateTime? @map("in_at") @db.Timestamptz(3)
  outAt        DateTime? @map("out_at") @db.Timestamptz(3)
  /// "self" or "manual"
  source       String
  markedById   String    @map("marked_by_id") @db.Uuid
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, membershipId, date])
  @@index([schoolId, date])
  @@map("staff_attendance")
}

/// A printed student ID card. Its QR code is a signed token naming only this card (KC1...), so
/// reissuing a card (a new row, the old one revoked) stops the old card at once.
model StudentCard {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  /// Random, carried in the token: a token made up for a real card id still fails.
  nonce          String
  validUntilYear Int       @map("valid_until_year")
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  issuedById     String    @map("issued_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById    String?   @map("revoked_by_id") @db.Uuid
  revokeReason   String?   @map("revoke_reason")

  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, studentId])
  @@map("student_cards")
}

// ---------------------------------------------------------------------------
// Stores and inventory. Quantities are integers in thousandths of the item's base unit
// ("_milli": 150 g of a kg item = 150; 2 pieces = 2000), values are integer cents. Stock on hand
// is always the sum of the append-only movements, never typed in.
// ---------------------------------------------------------------------------

/// A store (Food store, Uniform store, General store, Stationery... the school adds more).
model Store {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  /// food, uniform, general, stationery or other: which screens apply (meals, uniforms).
  kind      String
  position  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  items     StoreItem[]
  movements StockMovement[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("stores")
}

/// An item in a store, counted in a base unit (kg, litre, piece, packet...). Uniforms: one item per
/// size, with a price.
model StoreItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  name              String
  /// For uniforms: the size ("Size 12", "M"); empty otherwise.
  size              String   @default("")
  /// The base unit stock is issued and counted in.
  unit              String
  /// Shelf or category, for grouping the stock-take list.
  category          String   @default("")
  reorderLevelMilli Int      @default(0) @map("reorder_level_milli")
  /// Received in packs: "90 kg bag" holding pack_size_milli of the base unit.
  packName          String?  @map("pack_name")
  packSizeMilli     Int?     @map("pack_size_milli")
  tracksExpiry      Boolean  @default(false) @map("tracks_expiry")
  /// Uniforms: what the student is charged for one piece.
  priceCents        Int?     @map("price_cents")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store     Store           @relation(fields: [schoolId, storeId], references: [schoolId, id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([schoolId, storeId, name, size])
  @@unique([schoolId, id])
  @@map("store_items")
}

model Supplier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  phone     String?
  kraPin    String?  @map("kra_pin")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("suppliers")
}

/// The stock ledger (append-only). quantity_milli is signed: received +, issued -. value_cents is
/// signed the same way: a receipt's cost, or an issue valued at weighted average cost.
model StockMovement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  /// receive, issue, meal, transfer_out, transfer_in, adjust, stocktake, uniform_issue, uniform_return
  kind           String
  quantityMilli  Int       @map("quantity_milli")
  valueCents     Int       @map("value_cents")
  occurredOn     DateTime  @map("occurred_on") @db.Date
  supplierId     String?   @map("supplier_id") @db.Uuid
  deliveryNote   String?   @map("delivery_note")
  /// Received in packs: how many, and the pack size then (for the record).
  packs          Int?
  packSizeMilli  Int?      @map("pack_size_milli")
  expiryDate     DateTime? @map("expiry_date") @db.Date
  mealIssueId    String?   @map("meal_issue_id") @db.Uuid
  uniformIssueId String?   @map("uniform_issue_id") @db.Uuid
  stocktakeId    String?   @map("stocktake_id") @db.Uuid
  /// Links the two halves of a transfer.
  transferId     String?   @map("transfer_id") @db.Uuid
  /// Who it was issued to or what for ("Kitchen", "Science lab").
  issuedTo       String?   @map("issued_to")
  reason         String?
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store     @relation(fields: [schoolId, storeId], references: [schoolId, id], onDelete: Restrict)
  item  StoreItem @relation(fields: [schoolId, itemId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, itemId, occurredOn])
  @@index([schoolId, storeId, occurredOn])
  @@index([schoolId, mealIssueId])
  @@map("stock_movements")
}

/// The meals a school serves (configuration: Breakfast, Lunch, Supper, 10 o'clock tea...).
model Meal {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  name     String
  position Int
  active   Boolean @default(true)

  rations RationLine[]
  issues  MealIssue[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("meals")
}

/// The ration scale: how much of an item one student gets at a meal.
model RationLine {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String @map("school_id") @db.Uuid
  mealId          String @map("meal_id") @db.Uuid
  itemId          String @map("item_id") @db.Uuid
  perStudentMilli Int    @map("per_student_milli")

  meal Meal @relation(fields: [schoolId, mealId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, mealId, itemId])
  @@map("ration_lines")
}

/// One meal's issue from the food store: students served, what the ration scale suggested and
/// what was actually issued (the lines are stock movements). Flagged when off by more than the
/// school's variance percentage.
model MealIssue {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  mealId           String    @map("meal_id") @db.Uuid
  date             DateTime  @db.Date
  studentsServed   Int       @map("students_served")
  costCents        Int       @map("cost_cents")
  issuedById       String    @map("issued_by_id") @db.Uuid
  /// The cook confirms how many were actually served.
  servedConfirmed  Int?      @map("served_confirmed")
  confirmedById    String?   @map("confirmed_by_id") @db.Uuid
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// The largest difference from the ration scale, in tenths of a percent (125 = 12.5%).
  variancePermille Int       @default(0) @map("variance_permille")
  /// none, open (flagged, waiting for the Director), reviewed.
  varianceStatus   String    @default("none") @map("variance_status")
  reviewedById     String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewNote       String?   @map("review_note")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  meal  Meal            @relation(fields: [schoolId, mealId], references: [schoolId, id], onDelete: Restrict)
  lines MealIssueLine[]

  @@unique([schoolId, id])
  @@index([schoolId, date])
  @@map("meal_issues")
}

model MealIssueLine {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String @map("school_id") @db.Uuid
  mealIssueId      String @map("meal_issue_id") @db.Uuid
  itemId           String @map("item_id") @db.Uuid
  suggestedMilli   Int    @map("suggested_milli")
  actualMilli      Int    @map("actual_milli")
  costCents        Int    @map("cost_cents")
  /// (actual - suggested) / suggested, tenths of a percent; null when nothing was suggested.
  variancePermille Int?   @map("variance_permille")

  issue MealIssue @relation(fields: [schoolId, mealIssueId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, mealIssueId, itemId])
  @@map("meal_issue_lines")
}

/// A uniform piece given to a student: charged to their fees (a ledger charge on the Uniform vote
/// head), or paid separately. Returned or exchanged: the stock comes back and the charge is
/// reversed through the fees module.
model UniformIssue {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  studentId       String    @map("student_id") @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  quantity        Int
  unitPriceCents  Int       @map("unit_price_cents")
  totalCents      Int       @map("total_cents")
  /// charged or paid_separately
  payment         String
  paidReference   String?   @map("paid_reference")
  ledgerEntryId   String?   @map("ledger_entry_id") @db.Uuid
  issuedById      String    @map("issued_by_id") @db.Uuid
  issuedAt        DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  /// issued, returned
  status          String    @default("issued")
  returnedAt      DateTime? @map("returned_at") @db.Timestamptz(3)
  returnedById    String?   @map("returned_by_id") @db.Uuid
  returnReason    String?   @map("return_reason")
  /// An exchange: the issue that replaced this one.
  replacedById    String?   @map("replaced_by_id") @db.Uuid
  reversalEntryId String?   @map("reversal_entry_id") @db.Uuid

  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, studentId])
  @@map("uniform_issues")
}

/// A stock-take: counted on a phone, submitted, then approved (only approval changes stock).
model Stocktake {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  /// counting, submitted, approved, rejected
  status        String
  startedById   String    @map("started_by_id") @db.Uuid
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedById String?   @map("submitted_by_id") @db.Uuid
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(3)
  decidedById   String?   @map("decided_by_id") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  note          String?

  lines StocktakeLine[]

  @@unique([schoolId, id])
  @@index([schoolId, storeId])
  @@map("stocktakes")
}

model StocktakeLine {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String @map("school_id") @db.Uuid
  stocktakeId   String @map("stocktake_id") @db.Uuid
  itemId        String @map("item_id") @db.Uuid
  /// What the records said when the count was submitted.
  expectedMilli Int?   @map("expected_milli")
  countedMilli  Int?   @map("counted_milli")
  /// The difference's value at weighted average cost when submitted (signed).
  valueCents    Int?   @map("value_cents")

  stocktake Stocktake @relation(fields: [schoolId, stocktakeId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, stocktakeId, itemId])
  @@map("stocktake_lines")
}
